NODE_ENV=development
DB_HOST=localhost
DB_USER=nextstarter
DB_PASSWORD=supersecret
DB_NAME=nextstarter
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-value-here
GOOGLE_CLIENT_ID=your-value-here
GOOGLE_CLIENT_SECRET=your-value-here

# Comma-separated emails granted the admin role. Applied on sign-in, so an
# existing user is promoted the next time they log in. Removing an address here
# does not demote anyone - update the user's `role` column for that.
ADMIN_EMAILS=rboskind@gmail.com

# Optional web push credentials. Generate once with: pnpm exec web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Bugsink error tracking (Sentry-compatible). Leave unset to disable reporting.
# The DSN is public by design - it is embedded in the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@bugsink.example.com/1

# Optional: upload source maps to Bugsink during `next build` so production
# stack traces are readable. Uploading is skipped unless SENTRY_AUTH_TOKEN is
# set. SENTRY_ORG is always "bugsinkhasnoorgs" - Bugsink has no organizations.
SENTRY_URL=https://bugsink.example.com
SENTRY_ORG=bugsinkhasnoorgs
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=
